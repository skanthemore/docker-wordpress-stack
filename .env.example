# Copy this file to .env and replace every value. .env is gitignored;
# this template is the only one that belongs in the repository.

# ==================================
# DATABASE
# ==================================
MYSQL_ROOT_PASS=yourRootPassword
MYSQL_USER=wordpress_user
MYSQL_PASS=yourWordPressPassword
MYSQL_DB=wordpress_db

# ==================================
# SITE
# ==================================
WP_HOST=yourhost.local
WORDPRESS_URL=https://yourhost.local

# ==================================
# FIRST-RUN ADMIN
# Read from this file by the optional `wp core install` command in the
# README. WordPress itself never reads them — installing through the
# browser instead is perfectly fine.
# ==================================
WP_TITLE=My WordPress site
WP_USER=admin_user
WP_PASSWORD=yourSecureAdminPassword
WP_EMAIL=admin@yourhost.local

# ==================================
# TLS
# For local development: internal (Caddy issues its own certificate).
# For a real public domain: remove the caddy.tls label from compose or
# switch to a public issuance strategy.
# ==================================
CADDY_TLS_MODE=internal
